// EasyETA_HK Popup Script

// State
let state = {
    favorites: [],
    recent: [],
    currentTab: 'favorites'
};

// DOM Elements
const elements = {
    searchInput: document.getElementById('searchInput'),
    searchBtn: document.getElementById('searchBtn'),
    searchResults: document.getElementById('searchResults'),
    settingsBtn: document.getElementById('settingsBtn'),
    refreshBtn: document.getElementById('refreshBtn'),
    addRuleBtn: document.getElementById('addRuleBtn'),
    favoritesList: document.getElementById('favoritesList'),
    recentList: document.getElementById('recentList'),
    lastUpdate: document.getElementById('lastUpdate'),
    loadingOverlay: document.getElementById('loadingOverlay'),
    tabs: document.querySelectorAll('.tab'),
    tabContents: document.querySelectorAll('.tab-content')
};

// Initialize
document.addEventListener('DOMContentLoaded', async () => {
    await loadData();
    setupEventListeners();
    renderFavorites();
    renderRecent();
    updateLastUpdateTime();
});

// Load data from storage
async function loadData() {
    try {
        const data = await Storage.getAll();
        state.favorites = data.favorites || [];
        state.recent = data.recent || [];
    } catch (error) {
        console.error('Error loading data:', error);
    }
}

// Setup event listeners
function setupEventListeners() {
    // Search
    elements.searchBtn.addEventListener('click', handleSearch);
    elements.searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') handleSearch();
    });
    elements.searchInput.addEventListener('input', handleSearchInput);

    // Settings
    elements.settingsBtn.addEventListener('click', () => {
        chrome.runtime.openOptionsPage();
    });

    // Refresh
    elements.refreshBtn.addEventListener('click', handleRefreshAll);

    // Add Rule
    elements.addRuleBtn.addEventListener('click', () => {
        chrome.runtime.openOptionsPage();
    });

    // Tabs
    elements.tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            switchTab(tab.dataset.tab);
        });
    });
}

// Handle search
async function handleSearch() {
    const query = elements.searchInput.value.trim();
    if (!query) return;

    showLoading(true);
    
    try {
        // TODO: Implement actual search using HK ETA API
        // For now, show a placeholder
        const results = await searchBusStops(query);
        displaySearchResults(results);
        
        // Add to recent searches
        addToRecent(query);
    } catch (error) {
        console.error('Search error:', error);
        showError('Search failed. Please try again.');
    } finally {
        showLoading(false);
    }
}

// Handle search input
function handleSearchInput(e) {
    if (!e.target.value.trim()) {
        elements.searchResults.classList.add('hidden');
    }
}

// Search bus stops (placeholder - will be implemented with actual API)
async function searchBusStops(query) {
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 500));
    
    // Placeholder data
    return [
        {
            stopId: 'STOP001',
            stopName: 'Central (Exchange Square)',
            routes: ['1', '2', '5X', '10'],
            location: { lat: 22.2819, lng: 114.1580 }
        },
        {
            stopId: 'STOP002',
            stopName: 'Causeway Bay (Times Square)',
            routes: ['8', '19', '25A'],
            location: { lat: 22.2783, lng: 114.1826 }
        }
    ];
}

// Display search results
function displaySearchResults(results) {
    elements.searchResults.innerHTML = '';
    
    if (results.length === 0) {
        elements.searchResults.innerHTML = '<div class="search-result-item">No results found</div>';
    } else {
        results.forEach(result => {
            const item = document.createElement('div');
            item.className = 'search-result-item';
            item.innerHTML = `
                <div style="font-weight: 500;">${result.stopName}</div>
                <div style="font-size: 12px; color: #666; margin-top: 2px;">
                    Routes: ${result.routes.join(', ')}
                </div>
            `;
            item.addEventListener('click', () => addToFavorites(result));
            elements.searchResults.appendChild(item);
        });
    }
    
    elements.searchResults.classList.remove('hidden');
}

// Add to favorites
async function addToFavorites(stop) {
    const favorite = {
        stopId: stop.stopId,
        stopName: stop.stopName,
        routes: stop.routes,
        addedAt: new Date().toISOString()
    };
    
    // Check if already exists
    const exists = state.favorites.some(f => f.stopId === stop.stopId);
    if (exists) {
        showError('Stop already in favorites');
        return;
    }
    
    state.favorites.push(favorite);
    await Storage.set('favorites', state.favorites);
    
    renderFavorites();
    elements.searchResults.classList.add('hidden');
    elements.searchInput.value = '';
    
    // Show success feedback
    showSuccess('Added to favorites!');
}

// Remove from favorites
async function removeFromFavorites(stopId) {
    state.favorites = state.favorites.filter(f => f.stopId !== stopId);
    await Storage.set('favorites', state.favorites);
    renderFavorites();
}

// Render favorites
function renderFavorites() {
    if (state.favorites.length === 0) {
        elements.favoritesList.innerHTML = `
            <div class="empty-state">
                <p>📍 No favorites yet</p>
                <small>Search and add your favorite bus stops</small>
            </div>
        `;
        return;
    }
    
    elements.favoritesList.innerHTML = state.favorites.map(fav => `
        <div class="eta-card">
            <div class="eta-card-header">
                <div>
                    <div class="eta-card-title">${fav.stopName}</div>
                    <div class="eta-card-subtitle">Stop ID: ${fav.stopId}</div>
                </div>
                <div class="eta-card-actions">
                    <button onclick="refreshStop('${fav.stopId}')" title="Refresh">🔄</button>
                    <button onclick="removeFromFavorites('${fav.stopId}')" title="Remove">❌</button>
                </div>
            </div>
            <div class="eta-list" id="eta-${fav.stopId}">
                <div style="text-align: center; color: #999; padding: 8px;">
                    <small>Click refresh to load ETA</small>
                </div>
            </div>
        </div>
    `).join('');
}

// Render recent
function renderRecent() {
    if (state.recent.length === 0) {
        elements.recentList.innerHTML = `
            <div class="empty-state">
                <p>🕒 No recent searches</p>
                <small>Your search history will appear here</small>
            </div>
        `;
        return;
    }
    
    elements.recentList.innerHTML = state.recent.map(item => `
        <div class="eta-card">
            <div class="eta-card-title">${item.query}</div>
            <div class="eta-card-subtitle">${new Date(item.timestamp).toLocaleString()}</div>
        </div>
    `).join('');
}

// Add to recent searches
async function addToRecent(query) {
    const recent = {
        query,
        timestamp: new Date().toISOString()
    };
    
    state.recent.unshift(recent);
    state.recent = state.recent.slice(0, 10); // Keep last 10
    
    await Storage.set('recent', state.recent);
    renderRecent();
}

// Refresh specific stop
async function refreshStop(stopId) {
    const etaContainer = document.getElementById(`eta-${stopId}`);
    if (!etaContainer) return;
    
    etaContainer.innerHTML = '<div style="text-align: center; padding: 8px;">Loading...</div>';
    
    try {
        // TODO: Fetch actual ETA from API
        await new Promise(resolve => setTimeout(resolve, 500));
        
        // Placeholder ETA data
        const etas = [
            { route: '1', time: '3 mins', status: 'arriving' },
            { route: '1', time: '12 mins', status: 'soon' },
            { route: '5X', time: '18 mins', status: 'normal' }
        ];
        
        etaContainer.innerHTML = etas.map(eta => `
            <div class="eta-item">
                <span class="eta-route">${eta.route}</span>
                <span class="eta-time ${eta.status}">${eta.time}</span>
            </div>
        `).join('');
        
        updateLastUpdateTime();
    } catch (error) {
        console.error('Error refreshing ETA:', error);
        etaContainer.innerHTML = '<div style="text-align: center; color: #f44336; padding: 8px;">Failed to load</div>';
    }
}

// Refresh all favorites
async function handleRefreshAll() {
    showLoading(true);
    
    try {
        for (const fav of state.favorites) {
            await refreshStop(fav.stopId);
        }
    } finally {
        showLoading(false);
    }
}

// Switch tabs
function switchTab(tabName) {
    state.currentTab = tabName;
    
    elements.tabs.forEach(tab => {
        tab.classList.toggle('active', tab.dataset.tab === tabName);
    });
    
    elements.tabContents.forEach(content => {
        content.classList.toggle('active', content.id === `${tabName}Tab`);
    });
}

// Update last update time
function updateLastUpdateTime() {
    const now = new Date();
    elements.lastUpdate.textContent = now.toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit' 
    });
}

// Show loading overlay
function showLoading(show) {
    elements.loadingOverlay.classList.toggle('hidden', !show);
}

// Show error message
function showError(message) {
    // Simple alert for now - can be improved with toast notifications
    alert('❌ ' + message);
}

// Show success message
function showSuccess(message) {
    // Simple alert for now - can be improved with toast notifications
    alert('✓ ' + message);
}

// Make functions globally available for onclick handlers
window.removeFromFavorites = removeFromFavorites;
window.refreshStop = refreshStop;
